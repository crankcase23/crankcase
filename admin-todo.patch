+                    {canManage ? (
+                      <form action="/api/admin/tasks" method="post" className="mt-0.5 shrink-0">
+                        <input type="hidden" name="id" value={t.id} />
+                        <input type="hidden" name="action" value={t.status === "done" ? "reopen" : "complete"} />
+                        <button
+                          type="submit"
