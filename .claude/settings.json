{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-remote*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin main)",
      "Bash(git fetch -q origin main)",
      "Bash(git fetch --prune origin)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -vv)",
      "Bash(git branch --list*)",
      "Bash(git branch --contains*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b claude/*)",
      "Bash(git checkout -- next-env.d.ts)",
      "Bash(git merge origin/main)",
      "Bash(git merge --no-edit origin/main)",
      "Bash(bash scripts/github-preflight.sh check)",
      "Bash(bash scripts/github-preflight.sh check --build)",
      "Bash(bash scripts/github-preflight.sh receipt)",
      "Bash(python3 .claude/hooks/pretool-guard.test.py)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run factory:test)",
      "Bash(npm run visuals:check)",
      "Bash(npx --no-install tsc --noEmit)",
      "Bash(npx --no-install eslint)",
      "Bash(npx --no-install next typegen)",
      "Bash(npx --no-install next build)",
      "Bash(node --test scripts/visuals/factory-reconstructed/tests/*.test.mjs)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(date)",
      "Bash(which *)",
      "Bash(true)",
      "Bash(sleep *)",
      "Bash(cd *)",
      "Bash(mkdir -p *)"
    ],
    "ask": [
      "Bash(gh pr merge*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api --method PUT*)",
      "Bash(gh api * -X PUT*)",
      "Bash(gh api * --method PUT*)",
      "Bash(gh api *--method=PUT*)",
      "Bash(gh api *-XPUT*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *auto_merge*)",
      "Bash(gh api *deployments*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh api *releases*)",
      "Bash(gh api *environments*)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./scripts/github-preflight.sh)",
      "Write(./scripts/github-preflight.sh)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git push * :*)",
      "Bash(git push *:*)",
      "Bash(git push * +*)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git branch --delete*)",
      "Bash(git branch -f*)",
      "Bash(git branch --force*)",
      "Bash(git branch -m*)",
      "Bash(git switch -f*)",
      "Bash(git switch --force*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch -C*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git commit *--amend*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(gh repo*)",
      "Bash(gh secret*)",
      "Bash(gh auth*)",
      "Bash(gh api *--hostname*)",
      "Bash(gh api *=@.env*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(vercel*)",
      "Bash(npx vercel*)",
      "Bash(npx *vercel*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Bash(git reset*)",
      "Bash(git -C * reset*)",
      "Bash(git -C * clean*)",
      "Bash(git -C * rebase*)",
      "Bash(git filter-*)",
      "Bash(git update-ref*)",
      "Bash(git symbolic-ref*)",
      "Bash(git gc*)",
      "Bash(git prune*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)",
      "Bash(git remote remove*)",
      "Bash(git -c *)",
      "Bash(git -C * push*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf .claude*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretool-guard.py\""
          }
        ]
      }
    ]
  }
}
