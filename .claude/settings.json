{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git ls-remote*)",
      "Bash(git rev-parse*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git merge origin/main*)",
      "Bash(git checkout -b claude/*)",
      "Bash(git checkout -- next-env.d.ts)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push --set-upstream origin claude/*)",
      "Bash(bash scripts/github-preflight.sh*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run factory:test*)",
      "Bash(npm run visuals:check*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx next typegen*)",
      "Bash(npx next build*)",
      "Bash(node --test*)",
      "Bash(gh api repos/crankcase23/crankcase/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * :*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo*)",
      "Bash(gh secret*)",
      "Bash(gh auth*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api * -X PUT*)",
      "Bash(gh api * --method PUT*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *merge*)",
      "Bash(gh api *auto_merge*)",
      "Bash(gh api *git/refs*)",
      "Bash(gh api *actions/secrets*)",
      "Bash(gh api *actions/variables*)",
      "Bash(gh api *hooks*)",
      "Bash(gh api *keys*)",
      "Bash(gh api *collaborators*)",
      "Bash(vercel*)",
      "Bash(npx vercel*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Edit(./.claude/settings*.json)",
      "Write(./.claude/settings*.json)"
    ]
  }
}
