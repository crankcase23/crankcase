+        ) : (
+          <Table minWidth={800}>
+            <THead>
+              <tr>
+                <TH>Title</TH>
+                <TH>Type</TH>
+                <TH>Status</TH>
+                <TH>Published</TH>
+                <TH>Last modified</TH>
+                <TH align="right">Order</TH>
