+
+  const title =
+    [vehicle.year, vehicle.make, vehicle.model].filter(Boolean).join(" ") ||
+    (catalog ? `${catalog.year} ${catalog.make} ${catalog.model}` : "Unnamed vehicle");
+
+  return (
