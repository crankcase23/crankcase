+  alert: (
+    <>
+      <path d="M12 4.5 2.8 20h18.4z" />
+      <path d="M12 10v4.2M12 17.2h.01" />
+    </>
+  ),
+  search: (
+    <>
+      <circle cx="11" cy="11" r="6" />
+      <path d="M15.5 15.5 20 20" />
