+      .select({
+        status: vehicleDataCache.status,
+        n: sql<number>`count(*)::int`,
+      })
+      .from(vehicleDataCache)
+      .groupBy(vehicleDataCache.status),
+  ]);
+
+  const state = overallState(checks);
+  const now = new Date();
+
+  return (
+    <div>
+      <PageHeader
