# Copy this to .env.local for local dev (gitignored, never commit real secrets).
# On Vercel, set the same key under Project Settings -> Environment Variables.

# Shared password gate (src/proxy.ts) — required to keep the deployed site
# private. Leave unset locally if you don't want to be prompted for it while
# developing; the gate no-ops when this isn't set.
SITE_PASSWORD=

# Sync backend (accounts, garage, service history, odometer — src/db/schema.ts).
# Local dev: a local Postgres 16 instance (see build notes for setup). In
# production: the same var pointed at Vercel Postgres (or any Postgres host).
DATABASE_URL=

# Auth.js session encryption key. Generate one with: npx auth secret
AUTH_SECRET=

# Required for self-hosted (non-Vercel) deployments so Auth.js trusts the
# Host header it's served behind — without it every auth request 500s with
# "UntrustedHost". Vercel deployments don't need this.
AUTH_TRUST_HOST=true

# Email delivery for maintenance-reminder digests and account emails
# (src/lib/email.ts). Sign up at resend.com and create an API key.
RESEND_API_KEY=

# Optional -- defaults to Resend's shared sandbox sender, which works with
# no domain verification. Set this once crankcasegarage.com is verified in
# Resend (Settings -> Domains) so real users see that sender instead.
RESEND_FROM_EMAIL=

# Authorizes calls to the daily reminder-email cron
# (src/app/api/cron/maintenance-reminders). Vercel sends this automatically
# as "Authorization: Bearer <CRON_SECRET>" for scheduled cron requests once
# both this env var and vercel.json's crons entry are in place -- generate
# any random string for the value.
CRON_SECRET=
